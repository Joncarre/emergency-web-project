# ============================================================================
#  rapid-relief — variables de entorno (PLANTILLA)
#  Copia este archivo a `.env` y rellena los valores. NUNCA commitees `.env`.
# ============================================================================

# --- Configuración pública por despliegue (expuesta al cliente: prefijo PUBLIC_) ---
# Nombre del evento/catástrofe que se muestra en la interfaz.
PUBLIC_EVENT_NAME="Respuesta de Emergencia"
# Idioma por defecto: es | en
PUBLIC_DEFAULT_LOCALE="es"
# Módulos activos (coma-separados): people,pets,goods,offers,map
PUBLIC_ENABLED_MODULES="people,pets,goods,offers,map"
# Región/zona por defecto mostrada en formularios (texto libre).
PUBLIC_DEFAULT_ZONE=""

# --- Base de datos (Fase 2: Postgres gestionado + PostGIS) ---
# Cadena de conexión. Sin valor => el motor usa el repositorio en memoria (demo).
DATABASE_URL=""

# --- Almacenamiento de imágenes (objeto + CDN) ---
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Anti-abuso (CAPTCHA: Turnstile / hCaptcha) ---
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# --- Moderación (acceso mínimo, sin sistema de usuarios) ---
MODERATION_KEY=""

# --- Firma/hash de tokens de gestión de tarjetas ---
# Genera uno con: openssl rand -hex 32
TOKEN_SIGNING_SECRET=""
