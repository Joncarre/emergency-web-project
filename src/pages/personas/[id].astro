---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
import StateBadge from '@/components/StateBadge.astro';
import RevealContact from '@/components/RevealContact.tsx';
import { getRepository } from '@/lib/repository';
import { getStatusDef } from '@/lib/engine/modules';
import { formatDateTime, timeAgo } from '@/lib/utils/format';

const { lang, t } = Astro.locals;
const id = Astro.params.id!;

const repo = getRepository();
const card = await repo.getPerson(id);

if (!card) {
  Astro.response.status = 404;
}

const sp = Astro.url.searchParams;
const okSighting = sp.get('ok') === 'sighting';
const hasError = sp.get('err') != null;
const statusDef = card ? getStatusDef('people', card.status) : undefined;
---

<Layout title={card ? card.fullName : t('common.error.title')}>
  <a
    href="/personas"
    class="-ml-1 inline-flex items-center gap-1 text-sm text-fg-tertiary transition-colors hover:text-fg"
  >
    <Icon name="back" size={16} />
    {t('people.list.title')}
  </a>

  {
    !card ? (
      <div class="mt-6 rounded-[var(--radius-md)] border border-border bg-surface p-6 text-center">
        <p class="text-sm font-semibold text-fg">{t('people.manage.not_found')}</p>
      </div>
    ) : (
      <article class="mt-3">
        {okSighting && (
          <p class="mb-4 rounded-[var(--radius-sm)] border border-success/30 bg-success-soft px-3 py-2 text-sm font-medium text-success">
            {t('people.sighting.success')}
          </p>
        )}
        {hasError && (
          <p class="mb-4 rounded-[var(--radius-sm)] border border-danger/30 bg-danger-soft px-3 py-2 text-sm font-medium text-danger">
            {t('common.error.title')}
          </p>
        )}

        <div class="flex items-center justify-between gap-3">
          <StateBadge
            tone={statusDef?.tone ?? 'neutral'}
            label={t(`people.status.${card.status}` as any)}
            active={statusDef?.active ?? false}
          />
          <time class="text-xs text-fg-muted tabular" datetime={card.createdAt}>
            {t('people.card.reported')} {timeAgo(card.createdAt, lang)}
          </time>
        </div>

        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">{card.fullName}</h1>

        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-tertiary">
          <span class="font-medium text-fg-secondary">
            {t(`people.direction.${card.direction}` as any)}
          </span>
          {card.ageApprox != null && (
            <>
              <span aria-hidden="true">·</span>
              <span class="tabular">{t('people.age', { n: card.ageApprox })}</span>
            </>
          )}
          {card.zone && (
            <>
              <span aria-hidden="true">·</span>
              <span>{card.zone}</span>
            </>
          )}
        </div>

        {card.lastSeenAt && (
          <p class="mt-3 text-sm text-fg-secondary">
            <span class="text-fg-muted">{t('people.card.last_seen')}:</span>{' '}
            {formatDateTime(card.lastSeenAt, lang)}
          </p>
        )}

        {card.description && (
          <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-fg">
            {card.description}
          </p>
        )}

        {card.medicalNotes && (
          <p class="mt-3 rounded-[var(--radius-sm)] border border-border bg-surface-2 p-3 text-sm text-fg-secondary">
            <span class="font-medium">{t('people.field.medical')}:</span> {card.medicalNotes}
          </p>
        )}

        <div class="mt-5">
          <RevealContact client:idle lang={lang} id={card.id} />
        </div>

        {/* Avistamiento — cualquiera puede aportar una pista (form nativo, sin JS) */}
        <details class="mt-6 rounded-[var(--radius-md)] border border-border bg-surface">
          <summary class="flex cursor-pointer items-center gap-2 p-4 text-sm font-semibold text-fg marker:content-none">
            <Icon name="alert" size={18} class="text-warning" />
            {t('people.action.report_sighting')}
          </summary>
          <div class="border-t border-border p-4">
            <p class="text-sm text-fg-tertiary">{t('people.sighting.body')}</p>
            <form method="POST" action={`/api/personas/${card.id}/sighting`} class="mt-3 space-y-3">
              <textarea
                name="note"
                class="textarea"
                maxlength="500"
                placeholder={t('people.sighting.note')}
              />
              <input name="zone" class="input" maxlength="120" placeholder={t('common.zone')} />
              <div class="flex gap-2">
                <select name="contactMethod" class="select w-32 shrink-0">
                  <option value="phone">{t('common.contact.method.phone')}</option>
                  <option value="email">{t('common.contact.method.email')}</option>
                  <option value="other">{t('common.contact.method.other')}</option>
                </select>
                <input name="contactValue" class="input" maxlength="200" placeholder={t('common.contact')} />
              </div>
              <button
                type="submit"
                class="inline-flex min-h-11 w-full items-center justify-center rounded-[var(--radius-sm)] bg-warning px-4 text-sm font-medium text-on-accent transition-[transform,filter] duration-150 hover:brightness-110 active:scale-[0.98]"
              >
                {t('people.sighting.submit')}
              </button>
            </form>
          </div>
        </details>

        <p class="mt-4 text-center text-xs text-fg-muted">
          <a href={`/personas/gestionar?id=${card.id}`} class="underline hover:text-fg-secondary">
            {t('people.manage.title')}
          </a>
        </p>
      </article>
    )
  }
</Layout>
