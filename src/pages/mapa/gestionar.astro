---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
import StateBadge from '@/components/StateBadge.astro';
import { getRepository } from '@/lib/repository';
import { getStatusDef } from '@/lib/engine/modules';
import { availableTransitions } from '@/lib/engine/state-machine';

const { t } = Astro.locals;
const sp = Astro.url.searchParams;
const id = sp.get('id') ?? '';
const token = sp.get('token') ?? '';
const ok = sp.get('ok') === '1';
const err = sp.get('err');

const repo = getRepository();
const card = id ? await repo.getMapReport(id) : null;
const actor = card && token ? await repo.resolveActorMapReport(id, { manageToken: token }) : 'public';
const isOwner = actor === 'owner' || actor === 'moderator';
const transitions = card && isOwner ? availableTransitions('map', card.status, actor) : [];
const statusDef = card ? getStatusDef('map', card.status) : undefined;
const invalidToken = !!card && !!token && !isOwner;
---

<Layout title={t('map.manage.title')}>
  <a href="/mapa" class="-ml-1 inline-flex items-center gap-1 text-sm text-fg-tertiary transition-colors hover:text-fg">
    <Icon name="back" size={16} />
    {t('nav.back')}
  </a>

  <h1 class="mt-2 text-xl font-semibold tracking-tight text-fg">{t('map.manage.title')}</h1>

  {
    !id || !token ? (
      <div class="mt-4">
        <p class="text-sm text-fg-tertiary">{t('map.manage.intro')}</p>
        <form id="open-link" class="mt-3 flex gap-2">
          <input id="link-input" class="input" type="url" inputmode="url" placeholder="https://…/mapa/gestionar?id=…&token=…" />
          <button type="submit" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-primary px-4 text-sm font-medium text-on-accent hover:bg-primary-hover">
            {t('common.send')}
          </button>
        </form>
        <script is:inline>
          document.getElementById('open-link')?.addEventListener('submit', (e) => {
            e.preventDefault();
            const v = document.getElementById('link-input').value.trim();
            if (v) location.href = v;
          });
        </script>
      </div>
    ) : !card ? (
      <p class="mt-4 rounded-[var(--radius-sm)] border border-border bg-surface p-4 text-sm font-medium text-fg">
        {t('map.manage.not_found')}
      </p>
    ) : invalidToken ? (
      <p class="mt-4 rounded-[var(--radius-sm)] border border-danger/30 bg-danger-soft p-4 text-sm font-medium text-danger">
        {t('map.manage.invalid_token')}
      </p>
    ) : (
      <div class="mt-4">
        {ok && (
          <p class="mb-4 rounded-[var(--radius-sm)] border border-success/30 bg-success-soft px-3 py-2 text-sm font-medium text-success">
            {t('map.manage.done')}
          </p>
        )}
        {err && (
          <p class="mb-4 rounded-[var(--radius-sm)] border border-danger/30 bg-danger-soft px-3 py-2 text-sm font-medium text-danger">
            {t('map.manage.invalid_token')}
          </p>
        )}

        <div class="rounded-[var(--radius-md)] border border-border bg-surface p-4">
          <div class="flex items-center justify-between gap-3">
            <StateBadge
              tone={statusDef?.tone ?? 'neutral'}
              label={t(`map.status.${card.status}` as any)}
              active={statusDef?.active ?? false}
            />
            <span class="text-xs text-fg-muted">{t('map.manage.owner')}</span>
          </div>
          <h2 class="mt-2.5 text-lg font-semibold text-fg">{t(`map.type.${card.reportType}` as any)}</h2>
          {card.description && <p class="mt-1 text-sm text-fg-tertiary">{card.description}</p>}
        </div>

        <h3 class="mt-5 text-sm font-semibold uppercase tracking-wide text-fg-tertiary">
          {t('map.manage.actions')}
        </h3>
        <div class="mt-2 space-y-2">
          {transitions.map((tr) => (
            <form method="POST" action={`/api/mapa/${card.id}/transition`}>
              <input type="hidden" name="token" value={token} />
              <input type="hidden" name="to" value={tr.to} />
              <button
                type="submit"
                class="inline-flex min-h-11 w-full items-center justify-between rounded-[var(--radius-sm)] border border-border bg-surface px-4 text-sm font-medium text-fg transition-colors hover:bg-surface-2"
              >
                {t(tr.actionKey as any)}
                <Icon name="chevron" size={16} class="text-fg-muted" />
              </button>
            </form>
          ))}
        </div>
      </div>
    )
  }
</Layout>
