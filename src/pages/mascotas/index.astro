---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import CardResults from '@/components/CardResults.tsx';
import { getRepository } from '@/lib/repository';
import type { PetDirection, PetSpecies } from '@/lib/engine/types';

const { lang, t } = Astro.locals;
const sp = Astro.url.searchParams;
const dir = sp.get('direction');
const spc = sp.get('species');

const filters = {
  q: sp.get('q') ?? '',
  status: sp.get('status') ?? '',
  zone: sp.get('zone') ?? '',
  direction: dir === 'lost' || dir === 'found' ? dir : '',
  species: spc === 'dog' || spc === 'cat' || spc === 'other' ? spc : '',
};

const repo = getRepository();
const directionFilter = (filters.direction || undefined) as PetDirection | undefined;
const speciesFilter = (filters.species || undefined) as PetSpecies | undefined;
const [page, counts] = await Promise.all([
  repo.listPets({
    q: filters.q || undefined,
    status: filters.status || undefined,
    zone: filters.zone || undefined,
    direction: directionFilter,
    species: speciesFilter,
  }),
  repo.countPetsByStatus({
    q: filters.q || undefined,
    zone: filters.zone || undefined,
    direction: directionFilter,
    species: speciesFilter,
  }),
]);

const initial = { items: page.items, nextCursor: page.nextCursor, counts };
---

<Layout title={t('module.pets')} description={t('module.pets.desc')}>
  <a href="/" class="-ml-1 inline-flex items-center gap-1 text-sm text-fg-tertiary transition-colors hover:text-fg">
    <Icon name="back" size={16} />
    {t('nav.home')}
  </a>

  <div class="mt-2 flex items-center justify-between gap-3">
    <h1 class="text-xl font-semibold tracking-tight text-fg">{t('pets.list.title')}</h1>
    <Button href="/mascotas/nueva" size="sm">
      <Icon name="plus" size={16} />
      {t('pets.list.new')}
    </Button>
  </div>

  <div class="mt-4">
    <CardResults client:load lang={lang} module="pets" initial={initial} initialFilters={filters} />
  </div>
</Layout>
