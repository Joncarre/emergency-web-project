---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
import StateBadge from '@/components/StateBadge.astro';
import RevealContact from '@/components/RevealContact.tsx';
import { getRepository } from '@/lib/repository';
import { getStatusDef } from '@/lib/engine/modules';
import { timeAgo } from '@/lib/utils/format';

const { lang, t } = Astro.locals;
const id = Astro.params.id!;

const repo = getRepository();
const card = await repo.getPet(id);
if (!card) Astro.response.status = 404;

const statusDef = card ? getStatusDef('pets', card.status) : undefined;
const title = card ? card.name || t(`pets.species.${card.species}` as any) : t('common.error.title');
---

<Layout title={title}>
  <a href="/mascotas" class="-ml-1 inline-flex items-center gap-1 text-sm text-fg-tertiary transition-colors hover:text-fg">
    <Icon name="back" size={16} />
    {t('pets.list.title')}
  </a>

  {
    !card ? (
      <div class="mt-6 rounded-[var(--radius-md)] border border-border bg-surface p-6 text-center">
        <p class="text-sm font-semibold text-fg">{t('pets.manage.not_found')}</p>
      </div>
    ) : (
      <article class="mt-3">
        <div class="flex items-center justify-between gap-3">
          <StateBadge
            tone={statusDef?.tone ?? 'neutral'}
            label={t(`pets.status.${card.status}` as any)}
            active={statusDef?.active ?? false}
          />
          <time class="text-xs text-fg-muted tabular" datetime={card.createdAt}>
            {t('people.card.reported')} {timeAgo(card.createdAt, lang)}
          </time>
        </div>

        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-fg">{title}</h1>

        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-tertiary">
          <span class="font-medium text-fg-secondary">{t(`pets.direction.${card.direction}` as any)}</span>
          <span aria-hidden="true">·</span>
          <span>{t(`pets.species.${card.species}` as any)}</span>
          {card.breed && (<><span aria-hidden="true">·</span><span>{card.breed}</span></>)}
          {card.zone && (<><span aria-hidden="true">·</span><span>{card.zone}</span></>)}
        </div>

        {card.chipId && (
          <p class="mt-3 text-sm text-fg-secondary">
            <span class="text-fg-muted">{t('pets.field.chip')}:</span>{' '}
            <span class="tabular">{card.chipId}</span>
          </p>
        )}

        {card.description && (
          <p class="mt-3 whitespace-pre-line text-[15px] leading-relaxed text-fg">{card.description}</p>
        )}

        <div class="mt-5">
          <RevealContact client:idle lang={lang} endpoint={`/api/mascotas/${card.id}/contact`} />
        </div>

        <p class="mt-6 text-center text-xs text-fg-muted">
          <a href={`/mascotas/gestionar?id=${card.id}`} class="underline hover:text-fg-secondary">
            {t('pets.manage.title')}
          </a>
        </p>
      </article>
    )
  }
</Layout>
