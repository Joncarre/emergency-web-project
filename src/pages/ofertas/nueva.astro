---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
import OfferCreateForm from '@/components/OfferCreateForm.tsx';
import { deployment } from '@/config/deployment';

const { lang, t } = Astro.locals;
---

<Layout title={t('offers.new.title')} description={t('offers.new.intro')}>
  <a href="/ofertas" class="-ml-1 inline-flex items-center gap-1 text-sm text-fg-tertiary transition-colors hover:text-fg">
    <Icon name="back" size={16} />
    {t('offers.list.title')}
  </a>

  <h1 class="mt-2 text-xl font-semibold tracking-tight text-fg">{t('offers.new.title')}</h1>
  <p class="mt-1 text-sm text-fg-tertiary">{t('offers.new.intro')}</p>

  <div class="mt-5">
    <OfferCreateForm client:load lang={lang} defaultZone={deployment.defaultZone} />
  </div>
</Layout>
