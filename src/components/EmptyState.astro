---
/**
 * Estado vacío. Los estados explícitos (cargando / vacío / error) no son
 * opcionales: su ausencia es lo que hace que una interfaz parezca rota.
 */
import Icon from './Icon.astro';

interface Props {
  icon?: string;
  title: string;
  body?: string;
}
const { icon = 'search', title, body } = Astro.props;
---
<div class="flex flex-col items-center justify-center rounded-[var(--radius-md)] border border-dashed border-border px-6 py-14 text-center">
  <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-[var(--radius-full)] bg-surface-2 text-fg-tertiary">
    <Icon name={icon} size={22} />
  </span>
  <p class="text-sm font-semibold text-fg">{title}</p>
  {body && <p class="mt-1 max-w-xs text-sm text-fg-tertiary">{body}</p>}
  <slot />
</div>
