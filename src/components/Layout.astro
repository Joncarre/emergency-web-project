---
/**
 * Shell de la aplicación. Mobile-first, una columna. Incluye:
 *  - script inline anti-destello de tema (aplica data-theme antes de pintar)
 *  - skip-link de accesibilidad
 *  - AppBar (idioma/tema) y footer con aviso de privacidad
 */
import '@/styles/global.css';
import AppBar from './AppBar.astro';
import { deployment, isDemoMode } from '@/config/deployment';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const { lang, t } = Astro.locals;
const fullTitle = title ? `${title} · ${deployment.eventName}` : deployment.eventName;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0c1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('rr_theme') || 'system';
          var dark =
            t === 'dark' ||
            (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-[var(--radius-sm)] focus:bg-surface focus:px-3 focus:py-2 focus:shadow-[var(--shadow-overlay)]"
    >
      {t('nav.home')}
    </a>

    <AppBar />

    {
      isDemoMode && (
        <div class="border-b border-border bg-warning-soft text-warning">
          <p class="mx-auto max-w-3xl px-4 py-1.5 text-center text-xs font-medium">
            {t('demo.banner')}
          </p>
        </div>
      )
    }

    <main id="main" class="mx-auto w-full max-w-3xl px-4 pb-24 pt-5">
      <slot />
    </main>

    <footer class="mt-auto border-t border-border">
      <div class="mx-auto max-w-3xl px-4 py-6 text-xs text-fg-muted">
        <p>{t('footer.note')}</p>
      </div>
    </footer>
  </body>
</html>
